# Copy to .env and fill in. .env is never committed.

# OpenAI API key for the board assistant (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional overrides
# PORT=4000                       # backend port
# CHAT_URL=http://127.0.0.1:8000  # where the backend reaches the chat service
# OPENAI_BASE_URL=                # point the assistant at another OpenAI-compatible server (tests use a fake one)
