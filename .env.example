# Copy to .env and fill in. .env is never committed.

# Groq API key for the board assistant (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional overrides
# PORT=4000                       # backend port
# CHAT_URL=http://127.0.0.1:8000  # where the backend reaches the chat service
# GROQ_API_BASE=                  # point the assistant at another OpenAI-compatible server (tests use a fake one)
